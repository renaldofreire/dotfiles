# i3 configuration - minimal, mostly defaults
# Bar at top, Rofi for apps, Qtile-compatible keybindings

set $mod Mod4
set $terminal alacritty -e tmux new-session
set $rofi_drun rofi -show drun
set $rofi_run rofi -show run
set $rofi_window rofi -show window
set $quick_notes ~/dotfiles/scripts/quick-notes.sh

# ============================================================================
# BAR - TOP POSITION (only change from default)
# ============================================================================
bar {
    position top
    status_command i3status
    font pango:Ubuntu Nerd Font 13
    tray_output primary
}

# ============================================================================
# KEYBINDINGS - Qtile compatible
# ============================================================================

# Window focus (vim-style)
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# ============================================================================
# APPEARANCE - Borders and Gaps (Minimal space usage)
# ============================================================================
# Remover titlebars grandes do i3; usar apenas borda de 2px
default_border pixel 2
default_floating_border pixel 2

# Espaçamentos (Gaps) equivalentes às margens do Qtile
gaps inner 4
gaps outer 0
smart_gaps on
smart_borders on

# Move windows
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# Resize mode (equivalent to Qtile's Ctrl+Mod+arrows)
mode "resize" {
    bindsym h resize shrink width 10px
    bindsym j resize grow height 10px
    bindsym k resize shrink height 10px
    bindsym l resize grow width 10px
    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px
    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}
bindsym $mod+Control+h mode "resize"
bindsym $mod+Control+j mode "resize"
bindsym $mod+Control+k mode "resize"
bindsym $mod+Control+l mode "resize"

# Quick notes
bindsym $mod+n exec --no-startup-id $quick_notes

# Normalize (reset window sizes)
bindsym $mod+Shift+n layout toggle split

# Toggle split
bindsym $mod+Shift+Return split toggle

# Launch terminal
bindsym $mod+Return exec --no-startup-id $terminal

# Toggle layouts (tiling/tabbed/stacked)
bindsym $mod+Space layout toggle split

# Window switcher (Rofi)
bindsym $mod+Tab exec --no-startup-id $rofi_window

# Kill focused window
bindsym $mod+q kill

# Reload config
bindsym $mod+Shift+r reload

# Exit i3
bindsym $mod+Shift+q exit

# Run command prompt
bindsym $mod+r exec --no-startup-id i3-input -F 'exec %s' -P 'Run: '

# Audio
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5%

# Launchers (Rofi)
bindsym $mod+d exec --no-startup-id $rofi_drun
bindsym $mod+p exec --no-startup-id $rofi_run

# Window controls
bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+Space floating toggle

# Custom apps
bindsym Control+$mod+w exec --no-startup-id zen-browser
bindsym Control+$mod+f exec --no-startup-id alacritty -e nnn
bindsym Print exec --no-startup-id ksnip -r
bindsym Shift+F11 exec --no-startup-id alacritty -e redshift -O 4400
bindsym Shift+F12 exec --no-startup-id alacritty -e redshift -x

# Power management (i3lock com cor do tema monochrome_slate)
bindsym $mod+Control+s exec --no-startup-id sh -c 'i3lock -c 0f111a && sleep 1 && systemctl suspend'
bindsym $mod+Control+l exec --no-startup-id i3lock -c 0f111a

# ============================================================================
# WORKSPACES (1-10) - Default behavior, Qtile-style switching
# ============================================================================
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

bindsym $mod+Shift+1 move container to workspace number 1; workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2; workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3; workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4; workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5; workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6; workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7; workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8; workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9; workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10; workspace number 10

# ============================================================================
# MOUSE - Qtile compatible (Mod+drag to move, Mod+right-drag to resize)
# ============================================================================
floating_modifier $mod
bindsym $mod+button1 drag
bindsym $mod+button3 resize
bindsym $mod+button2 focus parent

# ============================================================================
# FLOATING RULES - For dialogs, Qtile quick-notes, etc.
# ============================================================================
for_window [window_type="dialog"] floating enable
for_window [window_type="menu"] floating enable
for_window [window_type="utility"] floating enable
for_window [window_type="splash"] floating enable
for_window [class="QuickNotes|quick-notes"] floating enable, resize set 55% 45%, move position center
for_window [class="confirmreset|makebranch|maketag|ssh-askpass|zenity|galculator"] floating enable
for_window [title="branchdialog|pinentry"] floating enable

# ============================================================================
# AUTOSTART - Minimal, matched with Qtile
# ============================================================================
exec_always --no-startup-id ~/.config/alacritty/scripts/theme_switcher.sh &
exec_always --no-startup-id eval $(/usr/bin/gnome-keyring-daemon --start --components=pkcs11,secrets,ssh)
exec_always --no-startup-id export SSH_AUTH_SOCK
exec_always --no-startup-id pkill -x picom; picom &
exec_always --no-startup-id nitrogen --restore &
exec_always --no-startup-id pgrep -x xdg-desktop-portal-gtk > /dev/null || /usr/lib/xdg-desktop-portal-gtk &
exec_always --no-startup-id pgrep -x nm-applet > /dev/null || /usr/bin/nm-applet --sm-disable --indicator &
exec_always --no-startup-id pgrep -x caffeine > /dev/null || caffeine &

# Instant Settings (DPMS and repeat rate - matched with Qtile)
exec_always --no-startup-id xset r rate 300 50
exec_always --no-startup-id xset s 600
exec_always --no-startup-id xset dpms 600 600 900

# Staggered app startup
exec --no-startup-id sleep 3 && alacritty &
exec --no-startup-id sleep 4 && zen-browser &
exec --no-startup-id sleep 5 && net.cozic.joplin_desktop &
exec --no-startup-id sleep 6 && strawberry &
exec --no-startup-id sleep 7 && dropbox start &

# PATH
exec_always --no-startup-id export PATH=$HOME/.local/bin:$PATH